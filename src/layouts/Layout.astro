    <!-- Phone Number Tracking Script -->
    <!-- HTML source contains real number (07949 912201) for SEO, JavaScript replaces with tracking number at runtime -->
    <script is:inline>
      (function() {
        const REAL_PHONE = '07949 912201';
        const REAL_PHONE_INTL = '+447949912201';
        const REAL_PHONE_TEL = 'tel:+447949912201';
        const REAL_PHONE_CLEAN = '447949912201';
        
        const TRACKING_PHONE = '07427 570533';
        const TRACKING_PHONE_INTL = '+447427570533';
        const TRACKING_PHONE_TEL = 'tel:+447427570533';
        const TRACKING_PHONE_CLEAN = '447427570533';
        
        // Track which nodes we've already processed to avoid infinite loops
        const processedNodes = new WeakSet();
        
        function replacePhoneNumbers() {
          // Replace text content
          const walker = document.createTreeWalker(
            document.body,
            NodeFilter.SHOW_TEXT,
            {
              acceptNode: function(node) {
                // Skip script and style tags
                const parent = node.parentElement;
                if (parent && (parent.tagName === 'SCRIPT' || parent.tagName === 'STYLE')) {
                  return NodeFilter.FILTER_REJECT;
                }
                // Skip if already processed
                if (processedNodes.has(node)) {
                  return NodeFilter.FILTER_REJECT;
                }
                return NodeFilter.FILTER_ACCEPT;
              }
            }
          );
          
          const textNodes = [];
          let node = walker.nextNode();
          
          while (node) {
            if (node.nodeType === Node.TEXT_NODE && node.textContent) {
              const text = node.textContent.trim();
              // Check if this text node contains the phone number
              if (
                text.includes(REAL_PHONE) ||
                text.includes(REAL_PHONE_INTL) ||
                text.includes('07949 912201') ||
                text.includes('+44 7949 912201') ||
                text.includes('7949 912201')
              ) {
                textNodes.push(node);
                processedNodes.add(node);
              }
            }
            node = walker.nextNode();
          }
          
          // Replace text content
          textNodes.forEach(function(textNode) {
            if (textNode.textContent) {
              let newText = textNode.textContent;
              
              // Replace various formats (be careful with order - most specific first)
              newText = newText.replace(/\+44\s?7949\s?912201/g, TRACKING_PHONE_INTL);
              newText = newText.replace(/\+447949912201/g, TRACKING_PHONE_INTL);
              newText = newText.replace(/07949\s?912201/g, TRACKING_PHONE);
              newText = newText.replace(/7949\s?912201/g, TRACKING_PHONE);
              newText = newText.replace(/447949912201/g, TRACKING_PHONE_CLEAN);
              
              if (newText !== textNode.textContent) {
                textNode.textContent = newText;
              }
            }
          });
          
          // Replace tel: links
          const telLinks = document.querySelectorAll('a[href^="tel:"]');
          telLinks.forEach(function(link) {
            const href = link.getAttribute('href');
            if (href) {
              // Replace various tel: formats
              if (href.includes(REAL_PHONE_CLEAN) || 
                  href.includes('447949912201') || 
                  href.includes('7949912201') ||
                  href === REAL_PHONE_TEL) {
                link.setAttribute('href', TRACKING_PHONE_TEL);
              }
            }
          });
          
          // Replace WhatsApp links
          const whatsappLinks = document.querySelectorAll('a[href*="wa.me"]');
          whatsappLinks.forEach(function(link) {
            const href = link.getAttribute('href');
            if (href && (href.includes('447949912201') || href.includes('7949912201'))) {
              link.setAttribute('href', href.replace(/447949912201|7949912201/g, TRACKING_PHONE_CLEAN));
            }
          });
        }
        
        // Run on DOM ready
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', replacePhoneNumbers);
        } else {
          replacePhoneNumbers();
        }
        
        // Also run after delays to catch dynamically loaded content (React components, etc.)
        setTimeout(replacePhoneNumbers, 100);
        setTimeout(replacePhoneNumbers, 500);
        setTimeout(replacePhoneNumbers, 1000);
        setTimeout(replacePhoneNumbers, 2000);
        
        // Use MutationObserver to catch dynamically added content
        if (typeof MutationObserver !== 'undefined') {
          const observer = new MutationObserver(function(mutations) {
            let shouldReplace = false;
            mutations.forEach(function(mutation) {
              if (mutation.addedNodes.length > 0) {
                shouldReplace = true;
              }
            });
            if (shouldReplace) {
              setTimeout(replacePhoneNumbers, 50);
            }
          });
          
          observer.observe(document.body, {
            childList: true,
            subtree: true
          });
        }
      })();
    </script>
  </body>
