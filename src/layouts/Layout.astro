---
import PhoneTrackingInit from '@/components/PhoneTrackingInit';
import { business, absoluteUrl, truncateMeta, googleMapsSearchUrl } from '@/data/business';
import { locations } from '@/data/locations';
import { TOTAL_VERIFIED_REVIEW_COUNT, AVERAGE_VERIFIED_RATING } from '@/data/testimonials';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  robots?: string;
}

const {
  title = `${business.alternateName} | Decking & Fencing in ${business.primaryCity} & ${business.secondaryCity}`,
  description = truncateMeta(business.description),
  canonical = absoluteUrl('/'),
  image = absoluteUrl(business.logo),
  robots = "index, follow",
} = Astro.props;

const currentUrl = canonical || Astro.url.href;
const ogImage = image || absoluteUrl(business.logo);

const businessId = `${business.siteUrl}/#business`;
const websiteId = `${business.siteUrl}/#website`;

// Deliberately no aggregateRating/review nodes here - see src/data/testimonials.ts
// for presentation-only reviews. Fabricated review structured data violates
// Google's structured-data guidelines.

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "HomeImprovementContractor", "ContractorService"],
  "@id": businessId,
  name: business.businessName,
  alternateName: business.alternateName,
  description: business.description,
  url: absoluteUrl('/'),
  telephone: business.phone,
  email: business.email,
  foundingDate: business.foundingDate,
  address: {
    "@type": "PostalAddress",
    ...business.address,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: business.mapCenter[0],
    longitude: business.mapCenter[1],
  },
  areaServed: locations.map((location) => ({
    "@type": "Place",
    name: location.name,
  })),
  serviceType: business.serviceTypes,
  openingHours: business.openingHoursSchema,
  openingHoursSpecification: business.openingHoursSpec.map((spec) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: spec.days,
    opens: spec.opens,
    closes: spec.closes,
  })),
  hasMap: googleMapsSearchUrl(),
  ...(TOTAL_VERIFIED_REVIEW_COUNT > 0
    ? {
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: AVERAGE_VERIFIED_RATING,
          reviewCount: TOTAL_VERIFIED_REVIEW_COUNT,
          bestRating: "5",
          worstRating: "1",
        },
      }
    : {}),
  priceRange: "$$",
  image: [
    absoluteUrl(business.logo),
    absoluteUrl("/gallery/deck1.jpg"),
    absoluteUrl("/gallery/deck2.jpg"),
    absoluteUrl("/gallery/Fence1.jpg"),
  ],
  logo: absoluteUrl(business.logo),
  sameAs: [business.facebookUrl],
  hasCredential: [
    {
      "@type": "EducationalOccupationalCredential",
      name: "Public Liability Insurance",
      description: "Fully insured for all decking and fencing work",
      credentialCategory: "insurance",
      recognizedBy: {
        "@type": "Organization",
        name: "Insurance Provider",
      },
    },
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Professional Decking & Fencing Services",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Composite Decking",
          description: "High-quality composite decking installation and maintenance",
          provider: { "@id": businessId },
        },
        priceRange: "£80-120 per square meter",
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Wooden Decking",
          description: "Professional wooden decking installation and repairs",
          provider: { "@id": businessId },
        },
        priceRange: "£60-100 per square meter",
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Fencing Installation",
          description: "Expert fencing installation and repair services",
          provider: { "@id": businessId },
        },
        priceRange: "£40-80 per linear meter",
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Custom Outdoor Structures",
          description: "Bespoke outdoor structures and joinery work",
          provider: { "@id": businessId },
        },
        priceRange: "Quote on request",
      },
    ],
  },
  makesOffer: [
    {
      "@type": "Offer",
      name: "Free Quote",
      description: "Complimentary, no-obligation quotes for all decking and fencing projects",
      price: "0",
      priceCurrency: "GBP",
    },
  ],
  paymentAccepted: ["Cash", "Bank Transfer", "Cheque"],
  currenciesAccepted: "GBP",
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": websiteId,
  name: business.alternateName,
  url: absoluteUrl('/'),
  inLanguage: "en-GB",
  publisher: { "@id": businessId },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/cds - Edited.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Basic Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={business.alternateName} />
    <meta name="robots" content={robots} />
    <meta name="language" content="English" />
    <meta name="geo.region" content={business.geoRegion} />
    <meta name="geo.placename" content={`${business.primaryCity}, Scotland`} />

    <!-- Canonical URL -->
    <link rel="canonical" href={currentUrl} />

    <!-- Hreflang: single UK canonical URL -->
    <link rel="alternate" hreflang="en-gb" href={currentUrl} />
    <link rel="alternate" hreflang="en" href={currentUrl} />
    <link rel="alternate" hreflang="x-default" href={currentUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/cds - Edited.png" />
    <link rel="alternate icon" href="/cds - Edited.png" />

    <!-- Preload critical resources -->
    <link rel="preload" href="/cds - Edited.png" as="image" type="image/png">

    <!-- Google Fonts with font-display: swap for better performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Google tag (gtag.js) -->
    <script define:vars={{ gaId: business.googleAnalyticsId }} is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${business.googleAnalyticsId}`} is:inline></script>

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="749" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${business.businessName} Logo`} />
    <meta property="og:site_name" content={business.alternateName} />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${business.businessName} Logo`} />

    <!-- Additional meta tags for better social sharing -->
    <meta name="theme-color" content="#1e40af" />
    <meta name="msapplication-TileColor" content="#1e40af" />
    <meta name="msapplication-TileImage" content={absoluteUrl(business.logo)} />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-white focus:text-primary focus:px-4 focus:py-2 focus:rounded-lg focus:font-semibold"
    >
      Skip to main content
    </a>
    <slot />
    <PhoneTrackingInit client:load />
  </body>
</html>

<style is:global>
  @import '../index.css';
</style>
