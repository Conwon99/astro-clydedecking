---
import Layout from '@/layouts/Layout.astro';
import Providers from '@/components/Providers';
import Navigation from '@/components/Navigation';
import Footer from '@/components/Footer';
import { ArrowRight } from 'lucide-react';
import { services } from '@/data/services';
import { locations, getNearbyLocationLinks, type LocationPage } from '@/data/locations';

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { locationSlug: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props as { location: LocationPage };
const city = location.name;
const canonical = `https://clydedeckingsolutionsltd.com/${location.slug}`;
const otherLocations = getNearbyLocationLinks(location);

/** Rotate through real project photography for the hero background — not claimed as photos of the town itself. */
const heroImages = ["/gallery/deck1.jpg", "/gallery/deck2.jpg", "/gallery/deck3.jpg", "/gallery/Fence1.jpg"];
const hashIndex = (input: string, modulo: number): number => {
  let hash = 0;
  for (let i = 0; i < input.length; i++) {
    hash = (hash * 31 + input.charCodeAt(i)) >>> 0;
  }
  return hash % modulo;
};
const heroImage = heroImages[hashIndex(location.slug, heroImages.length)];
const absoluteHeroImage = `https://clydedeckingsolutionsltd.com${heroImage}`;

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  url: canonical,
  name: location.title,
  description: location.description,
  primaryImageOfPage: { "@type": "ImageObject", url: absoluteHeroImage },
  inLanguage: "en-GB",
};
const placeSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "@id": `${canonical}#place`,
  name: city,
  description: location.intro,
  containedInPlace: {
    "@type": "AdministrativeArea",
    name: location.county,
  },
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: location.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://clydedeckingsolutionsltd.com/" },
    { "@type": "ListItem", position: 2, name: "Locations", item: "https://clydedeckingsolutionsltd.com/locations" },
    { "@type": "ListItem", position: 3, name: city, item: canonical },
  ],
};
---

<Layout
  title={location.title}
  description={location.description}
  canonical={canonical}
>
  <Providers client:load>
    <div class="min-h-screen bg-background">
      <Navigation client:load />

      {/* Hero Section */}
      <section
        class="relative pt-28 pb-14 px-4 bg-cover bg-center"
        style={`background-image: linear-gradient(to bottom, rgba(15,23,42,0.72), rgba(15,23,42,0.82)), url('${heroImage}')`}
      >
        <div class="container mx-auto max-w-5xl text-center">
          <h1 class="font-display font-bold text-3xl sm:text-4xl lg:text-6xl text-white mb-4">
            <span class="text-primary">Decking & Fencing</span><br />
            Services in {city}
          </h1>
          <p class="text-base sm:text-xl text-white/90 max-w-3xl mx-auto mb-6">
            {location.intro}
          </p>
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-8 py-4 bg-green-600 hover:bg-green-700 text-white rounded-full font-bold transition-colors"
          >
            Get a Free Quote
          </a>
        </div>
      </section>

      {/* Services in this city */}
      <section class="py-20 px-4">
        <div class="container mx-auto max-w-6xl">
          <div class="text-center mb-12">
            <h2 class="font-display font-bold text-4xl text-foreground mb-4">
              Services in {city}
            </h2>
            <p class="text-xl text-muted-foreground max-w-3xl mx-auto">
              Covering {city} ({location.postcode}) and the surrounding {location.county} area.
            </p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {services.map((service) => (
              <a
                href={`/services/${service.slug}`}
                class="group bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300 flex flex-col"
              >
                <div class="aspect-[4/3] overflow-hidden">
                  <img
                    src={service.image}
                    alt={`${service.title} in ${city}`}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <div class="p-6 flex flex-col flex-1">
                  <h3 class="font-display font-bold text-xl text-foreground mb-2">
                    {service.title} in {city}
                  </h3>
                  <p class="text-muted-foreground mb-4 flex-1">
                    {service.description}
                  </p>
                  <span class="inline-flex items-center gap-2 text-primary font-semibold group-hover:gap-3 transition-all">
                    Learn more
                    <ArrowRight class="w-4 h-4" />
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      {/* Other areas we cover */}
      <section class="py-16 px-4 bg-muted/50">
        <div class="container mx-auto max-w-4xl text-center">
          <h2 class="font-display font-bold text-3xl text-foreground mb-6">
            Other areas we cover
          </h2>
          <div class="flex flex-wrap justify-center gap-4">
            {otherLocations.map((nearby) => (
              <a
                href={`/${nearby.slug}`}
                class="inline-flex items-center px-6 py-3 bg-white rounded-full font-semibold text-primary border border-primary/20 hover:bg-primary hover:text-white transition-colors"
              >
                Decking & Fencing in {nearby.name}
              </a>
            ))}
            <a
              href="/locations"
              class="inline-flex items-center px-6 py-3 bg-white rounded-full font-semibold text-primary border border-primary/20 hover:bg-primary hover:text-white transition-colors"
            >
              View all areas
            </a>
          </div>
        </div>
      </section>

      {/* FAQ Section */}
      <section class="py-20 px-4">
        <div class="container mx-auto max-w-4xl">
          <div class="text-center mb-12">
            <h2 class="font-display font-bold text-4xl text-foreground mb-4">
              {city} — Frequently Asked Questions
            </h2>
          </div>
          <div class="space-y-4">
            {location.faqs.map((faq) => (
              <div class="bg-white rounded-2xl p-6 shadow-lg">
                <h3 class="font-semibold text-lg text-foreground mb-2">
                  {faq.question}
                </h3>
                <p class="text-muted-foreground leading-relaxed">
                  {faq.answer}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* CTA Section */}
      <section class="py-16 px-4 bg-primary text-white">
        <div class="container mx-auto max-w-4xl text-center">
          <h2 class="font-display font-bold text-4xl mb-4">
            Ready to Transform Your {city} Garden?
          </h2>
          <p class="text-xl mb-8 opacity-90">
            Get your free quote today and join our satisfied {city} customers
          </p>
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary rounded-full font-bold hover:bg-gray-100 transition-colors"
          >
            Get a Free Quote
          </a>
        </div>
      </section>
    </div>
    <Footer client:load />
  </Providers>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(placeSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>

<script>
  import { trackPageView } from '@/utils/analytics';

  if (typeof window !== 'undefined') {
    trackPageView(window.location.pathname, document.title);
  }
</script>
