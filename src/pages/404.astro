---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="404 - Page Not Found | Clyde Decking"
  description="The page you're looking for doesn't exist. Return to Clyde Decking homepage for professional decking and fencing services in Glasgow, Edinburgh, Stirling, Ayrshire & Scotland's Central Belt."
  canonical="https://clydedeckingsolutionsltd.com/404"
  robots="noindex, nofollow"
>
  <div class="min-h-screen flex items-center justify-center bg-gray-100">
    <div class="text-center max-w-md mx-auto px-4">
      <h1 class="text-6xl font-bold text-[hsl(var(--grass-green))] mb-4">404</h1>
      <h2 class="text-2xl font-semibold text-[hsl(var(--asphalt-grey))] mb-4">Page Not Found</h2>
      <p class="text-lg text-[hsl(var(--asphalt-grey))] mb-8 leading-relaxed">
        Sorry, the page you're looking for doesn't exist. It might have been moved, deleted, or you entered the wrong URL.
      </p>
      
      <div class="space-y-4">
        <a 
          href="/" 
          class="inline-block bg-[hsl(var(--grass-green))] text-white px-8 py-3 rounded-full font-semibold hover:opacity-90 transition-opacity"
        >
          Return to Homepage
        </a>
        
        <div class="text-sm text-[hsl(var(--asphalt-grey))]">
          <p class="mb-2">Or explore our services:</p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="/#services" class="text-[hsl(var(--grass-green))] hover:underline">Our Services</a>
            <a href="/#about" class="text-[hsl(var(--grass-green))] hover:underline">About Us</a>
            <a href="/contact" class="text-[hsl(var(--grass-green))] hover:underline">Contact</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { trackPageView } from '@/utils/analytics';
  
  if (typeof window !== 'undefined') {
    trackPageView(window.location.pathname, document.title);
  }
</script>



