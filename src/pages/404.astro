---
import Layout from '@/layouts/Layout.astro';
import { absoluteUrl } from '@/data/business';
---

<Layout
  title="404 - Page Not Found | Clyde Decking"
  description="The page you're looking for doesn't exist. Return to Clyde Decking's homepage for decking and fencing services across Glasgow and the Central Belt."
  canonical={absoluteUrl('/404')}
  robots="noindex, follow"
>
  <div class="min-h-screen flex items-center justify-center bg-muted/30">
    <div class="text-center max-w-md mx-auto px-4">
      <h1 class="text-6xl font-bold text-primary mb-4">404</h1>
      <h2 class="text-2xl font-semibold text-foreground mb-4">Page Not Found</h2>
      <p class="text-lg text-muted-foreground mb-8 leading-relaxed">
        Sorry, the page you're looking for doesn't exist. It might have been moved, deleted, or you entered the wrong URL.
      </p>

      <div class="space-y-4">
        <a
          href="/"
          class="inline-block bg-primary text-white px-8 py-3 rounded-full font-semibold hover:bg-primary/90 transition-colors"
        >
          Return to Homepage
        </a>

        <div class="text-sm text-muted-foreground">
          <p class="mb-2">Or explore our site:</p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="/services" class="text-primary hover:underline">Our Services</a>
            <a href="/locations" class="text-primary hover:underline">Areas We Cover</a>
            <a href="/contact" class="text-primary hover:underline">Contact</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { trackPageView } from '@/utils/analytics';

    if (typeof window !== 'undefined') {
      trackPageView(window.location.pathname, document.title);
    }
  </script>
</Layout>
