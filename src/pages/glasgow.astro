---
import Layout from '@/layouts/Layout.astro';
import Providers from '@/components/Providers';
import { MapPin, Star, Clock, Shield, Award, Phone } from 'lucide-react';
import LazyImage from '@/components/LazyImage';
import WhatsAppIcon from '@/components/WhatsAppIcon';

const localLandmarks = [
  "Glasgow Cathedral",
  "Kelvingrove Park",
  "Glasgow Green",
  "Pollok Country Park",
  "Botanic Gardens",
  "Riverside Museum",
  "Glasgow Science Centre",
  "People's Palace"
];

const neighborhoods = [
  "West End",
  "East End", 
  "Southside",
  "North Glasgow",
  "Merchant City",
  "West End",
  "Shawlands",
  "Bearsden",
  "Milngavie",
  "Newton Mearns"
];

const localTestimonials = [
  {
    name: "Sarah Mitchell",
    location: "West End, Glasgow",
    rating: 5,
    text: "Clyde Decking transformed our West End garden with beautiful composite decking. The team worked around the historic tenement building restrictions perfectly. Highly recommend!",
    service: "Composite Decking",
    landmark: "Near Kelvingrove Park"
  },
  {
    name: "James Campbell",
    location: "Bearsden, Glasgow", 
    rating: 5,
    text: "Living near Glasgow Cathedral, we needed fencing that complemented the area's heritage. Clyde Decking delivered exactly what we wanted - professional and respectful of the local character.",
    service: "Fencing Installation",
    landmark: "Near Glasgow Cathedral"
  },
  {
    name: "Emma Thompson",
    location: "Shawlands, Glasgow",
    rating: 5,
    text: "Our Southside home needed decking that could handle Glasgow's weather. The composite decking they installed has been perfect - no maintenance and looks great year-round!",
    service: "Composite Decking", 
    landmark: "Near Pollok Country Park"
  }
];

const localPainPoints = [
  "Glasgow's wet climate causing decking to rot and warp",
  "Historic building restrictions limiting outdoor modifications",
  "High foot traffic areas requiring durable fencing solutions",
  "Limited space in tenement gardens requiring smart design",
  "Council planning requirements for conservation areas",
  "Salt air from the Clyde affecting outdoor structures",
  "Glasgow's variable weather requiring weather-resistant materials"
];
---

<Layout
  title="Decking & Fencing Services in Glasgow | Clyde Decking Solutions"
  description="Expert decking & fencing services in Glasgow. Serving West End, East End, Southside & all Glasgow areas. Composite & wooden decking, fencing installation. Free quotes available."
  canonical="https://clydedecking.netlify.app/glasgow"
>
  <Providers client:load>
    <div class="min-h-screen bg-background">
      {/* Hero Section */}
      <section class="relative py-20 px-4 bg-gradient-to-br from-primary/10 to-primary/5">
        <div class="container mx-auto max-w-7xl">
          <div class="text-center mb-12">
            <h1 class="font-display font-bold text-5xl lg:text-6xl text-foreground mb-6">
              <span class="text-primary">Decking & Fencing</span><br />
              Services in Glasgow
            </h1>
            <p class="text-xl text-muted-foreground max-w-3xl mx-auto mb-8">
              Serving Glasgow's most prestigious areas including West End, East End, Southside, and all surrounding neighborhoods. 
              Expert decking and fencing solutions tailored to Glasgow's unique character and climate.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a
                href="tel:+447949912201"
                data-track-source="glasgow_hero"
                class="inline-flex items-center justify-center px-8 py-4 bg-primary text-white rounded-full font-semibold hover:bg-primary/90 transition-colors phone-link"
              >
                <Phone class="w-5 h-5 mr-2" />
                Call 07949 912201
              </a>
              <a
                href="https://wa.me/447949912201"
                target="_blank"
                rel="noopener noreferrer"
                data-track-source="glasgow_hero"
                class="inline-flex items-center justify-center px-8 py-4 border-2 border-primary text-primary rounded-full font-semibold hover:bg-primary hover:text-white transition-colors whatsapp-link"
              >
                <WhatsAppIcon client:load class="w-5 h-5 mr-2" />
                WhatsApp Us
              </a>
            </div>
          </div>
        </div>
      </section>

      {/* Local Areas Served */}
      <section class="py-16 px-4">
        <div class="container mx-auto max-w-7xl">
          <div class="text-center mb-12">
            <h2 class="font-display font-bold text-4xl text-foreground mb-4">
              Glasgow Areas We Serve
            </h2>
            <p class="text-xl text-muted-foreground">
              From the historic West End to the vibrant Southside, we cover all of Glasgow
            </p>
          </div>
          
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 mb-12">
            {neighborhoods.map((area) => (
              <div
                key={area}
                class="flex items-center gap-2 p-3 rounded-lg bg-background border border-border hover:border-primary/30 transition-colors group"
              >
                <MapPin class="w-4 h-4 text-primary flex-shrink-0" />
                <span class="text-foreground font-medium group-hover:text-primary transition-colors">
                  {area}
                </span>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Local Landmarks & Context */}
      <section class="py-16 px-4 bg-muted/50">
        <div class="container mx-auto max-w-7xl">
          <div class="text-center mb-12">
            <h2 class="font-display font-bold text-4xl text-foreground mb-4">
              Proudly Serving Glasgow's Iconic Areas
            </h2>
            <p class="text-xl text-muted-foreground">
              We understand Glasgow's unique character and work with local landmarks and conservation areas
            </p>
          </div>
          
          <div class="grid md:grid-cols-2 gap-8">
            <div>
              <h3 class="font-display font-bold text-2xl text-foreground mb-4">
                Local Landmarks We Work Near
              </h3>
              <div class="grid grid-cols-2 gap-3">
                {localLandmarks.map((landmark) => (
                  <div
                    key={landmark}
                    class="flex items-center gap-2 p-3 rounded-lg bg-background border border-border"
                  >
                    <Award class="w-4 h-4 text-primary flex-shrink-0" />
                    <span class="text-foreground font-medium">{landmark}</span>
                  </div>
                ))}
              </div>
            </div>
            
            <div>
              <h3 class="font-display font-bold text-2xl text-foreground mb-4">
                Common Glasgow Challenges We Solve
              </h3>
              <ul class="space-y-3">
                {localPainPoints.map((painPoint) => (
                  <li key={painPoint} class="flex items-start gap-3">
                    <div class="w-2 h-2 bg-primary rounded-full mt-2 flex-shrink-0"></div>
                    <span class="text-muted-foreground">{painPoint}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>

      {/* Local Testimonials */}
      <section class="py-16 px-4">
        <div class="container mx-auto max-w-7xl">
          <div class="text-center mb-12">
            <h2 class="font-display font-bold text-4xl text-foreground mb-4">
              What Glasgow Customers Say
            </h2>
            <p class="text-xl text-muted-foreground">
              Real reviews from real Glasgow customers
            </p>
          </div>
          
          <div class="grid md:grid-cols-3 gap-8">
            {localTestimonials.map((testimonial) => (
              <div key={testimonial.name} class="bg-background border border-border rounded-xl p-6 hover:border-primary/30 transition-colors">
                <div class="flex items-center gap-1 mb-4">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <Star
                      key={i}
                      class="w-5 h-5 text-accent fill-current"
                    />
                  ))}
                </div>
                <p class="text-muted-foreground mb-4 italic">"{testimonial.text}"</p>
                <div class="border-t border-border pt-4">
                  <div class="font-semibold text-foreground">{testimonial.name}</div>
                  <div class="text-sm text-muted-foreground">{testimonial.location}</div>
                  <div class="text-sm text-primary">{testimonial.landmark}</div>
                  <div class="text-sm text-muted-foreground">{testimonial.service}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Why Choose Us for Glasgow */}
      <section class="py-16 px-4 bg-muted/50">
        <div class="container mx-auto max-w-7xl">
          <div class="text-center mb-12">
            <h2 class="font-display font-bold text-4xl text-foreground mb-4">
              Why Glasgow Chooses Clyde Decking
            </h2>
          </div>
          
          <div class="grid md:grid-cols-3 gap-8">
            <div class="text-center">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <Shield class="w-8 h-8 text-primary" />
              </div>
              <h3 class="font-display font-bold text-xl text-foreground mb-2">
                Glasgow Climate Expertise
              </h3>
              <p class="text-muted-foreground">
                We understand Glasgow's wet climate and choose materials that withstand the weather
              </p>
            </div>
            
            <div class="text-center">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <Award class="w-8 h-8 text-primary" />
              </div>
              <h3 class="font-display font-bold text-xl text-foreground mb-2">
                Conservation Area Experience
              </h3>
              <p class="text-muted-foreground">
                Experienced with Glasgow's conservation areas and planning requirements
              </p>
            </div>
            
            <div class="text-center">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <Clock class="w-8 h-8 text-primary" />
              </div>
              <h3 class="font-display font-bold text-xl text-foreground mb-2">
                Local Knowledge
              </h3>
              <p class="text-muted-foreground">
                We know Glasgow's neighborhoods and work around local restrictions
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* CTA Section */}
      <section class="py-16 px-4 bg-primary text-white">
        <div class="container mx-auto max-w-4xl text-center">
          <h2 class="font-display font-bold text-4xl mb-4">
            Ready to Transform Your Glasgow Garden?
          </h2>
          <p class="text-xl mb-8 opacity-90">
            Get your free quote today and join hundreds of satisfied Glasgow customers
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="tel:+447949912201"
              data-track-source="glasgow_cta"
              class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary rounded-full font-semibold hover:bg-gray-100 transition-colors phone-link"
            >
              <Phone class="w-5 h-5 mr-2" />
              Call 07949 912201
            </a>
            <a
              href="https://wa.me/447949912201"
              target="_blank"
              rel="noopener noreferrer"
              data-track-source="glasgow_cta"
              class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white rounded-full font-semibold hover:bg-white hover:text-primary transition-colors whatsapp-link"
            >
              <WhatsAppIcon client:load class="w-5 h-5 mr-2" />
              WhatsApp Us
            </a>
          </div>
        </div>
      </section>
    </div>
  </Providers>
</Layout>

<script>
  import { trackPageView, trackPhoneCall, trackMessenger } from '@/utils/analytics';
  
  if (typeof window !== 'undefined') {
    trackPageView(window.location.pathname, document.title);
    
    // Track phone calls
    document.querySelectorAll('.phone-link').forEach(link => {
      link.addEventListener('click', () => {
        const source = link.getAttribute('data-track-source') || 'unknown';
        trackPhoneCall(source);
      });
    });
    
    // Track WhatsApp clicks
    document.querySelectorAll('.whatsapp-link').forEach(link => {
      link.addEventListener('click', () => {
        const source = link.getAttribute('data-track-source') || 'unknown';
        trackMessenger(source);
      });
    });
  }
</script>

