---
import Layout from '@/layouts/Layout.astro';
import Providers from '@/components/Providers';
import Navigation from '@/components/Navigation';
import Footer from '@/components/Footer';
import { Phone, ArrowRight } from 'lucide-react';
import WhatsAppIcon from '@/components/WhatsAppIcon';
import { services } from '@/data/services';

const city = "Stirling";
const intro = "Clyde Decking Solutions installs and repairs decking and fencing across Stirling, from city centre properties near the historic Old Town to the larger gardens of Bridge of Allan, Dunblane and Bannockburn. Layouts are planned around Stirling's hilly terrain and the conservation-area restrictions found close to the castle and old town.";
const nearbyAreas = "Stirling City Centre, Bridge of Allan, Dunblane, Bannockburn, Causewayhead and St. Ninians";

const canonical = "https://clydedeckingsolutionsltd.com/stirling";
const otherLocations = [
  { name: "Glasgow", slug: "glasgow" },
  { name: "Edinburgh", slug: "edinburgh" },
];

const faqs = [
  {
    question: "Do you install decking and fencing in Stirling?",
    answer: "Yes. Clyde Decking Solutions installs and repairs both decking and fencing across Stirling, including the city centre, Bridge of Allan, Dunblane and Bannockburn. Free quotes are available.",
  },
  {
    question: "Can you build decking on Stirling's hilly gardens?",
    answer: "Yes. Stirling's terrain means many gardens, particularly around the city centre and older parts of town, have noticeable slopes. We build raised and stepped decking to turn an uneven garden into level, usable outdoor space.",
  },
  {
    question: "Do you work near Stirling Castle's conservation area?",
    answer: "Yes. Properties close to Stirling Castle and the Old Town sit within a conservation area with planning restrictions on outdoor structures. We're experienced working within those requirements and can advise what's likely to need planning permission.",
  },
  {
    question: "Do you cover the university area and surrounding towns?",
    answer: "Yes. Alongside Stirling city centre, we regularly work in Bridge of Allan, Dunblane, Bannockburn and the areas around Stirling University. If you're just outside these, get in touch and we can confirm coverage.",
  },
  {
    question: "How do I get a decking or fencing quote in Stirling?",
    answer: `Call 07949 912201, WhatsApp us, or use the contact form with a brief description of the ${city} property and a few photos if you have them. Quotes are free and there's no obligation to proceed.`,
  },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  url: canonical,
  name: "Decking & Fencing Services in Stirling | Clyde Decking Solutions",
  description: "Expert decking & fencing services in Stirling. Serving Bridge of Allan, Dunblane, Bannockburn & all Stirling areas. Composite & wooden decking, fencing installation. Free quotes available.",
  inLanguage: "en-GB",
};
const placeSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "@id": `${canonical}#place`,
  name: city,
  description: intro,
  containedInPlace: {
    "@type": "AdministrativeArea",
    name: "Scotland",
  },
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://clydedeckingsolutionsltd.com/" },
    { "@type": "ListItem", position: 2, name: "Locations", item: "https://clydedeckingsolutionsltd.com/locations" },
    { "@type": "ListItem", position: 3, name: city, item: canonical },
  ],
};
---

<Layout
  title="Decking & Fencing Services in Stirling | Clyde Decking Solutions"
  description="Expert decking & fencing services in Stirling. Serving Bridge of Allan, Dunblane, Bannockburn & all Stirling areas. Composite & wooden decking, fencing installation. Free quotes available."
  canonical={canonical}
>
  <Providers client:load>
    <div class="min-h-screen bg-background">
      <Navigation client:load />

      {/* Hero Section */}
      <section class="relative py-24 px-4 pt-32 bg-gradient-to-br from-primary/10 to-primary/5">
        <div class="container mx-auto max-w-5xl text-center">
          <h1 class="font-display font-bold text-5xl lg:text-6xl text-foreground mb-6">
            <span class="text-primary">Decking & Fencing</span><br />
            Services in {city}
          </h1>
          <p class="text-xl text-muted-foreground max-w-3xl mx-auto mb-8">
            {intro}
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/contact"
              data-track-source="stirling_hero"
              class="inline-flex items-center justify-center px-8 py-4 bg-green-600 hover:bg-green-700 text-white rounded-full font-bold transition-colors"
            >
              Get a Free Quote
            </a>
            <a
              href="tel:+447949912201"
              data-track-source="stirling_hero"
              class="inline-flex items-center justify-center px-8 py-4 bg-primary text-white rounded-full font-semibold hover:bg-primary/90 transition-colors phone-link"
            >
              <Phone class="w-5 h-5 mr-2" />
              Call 07949 912201
            </a>
            <a
              href="https://wa.me/447949912201"
              target="_blank"
              rel="noopener noreferrer"
              data-track-source="stirling_hero"
              class="inline-flex items-center justify-center px-8 py-4 border-2 border-primary text-primary rounded-full font-semibold hover:bg-primary hover:text-white transition-colors whatsapp-link"
            >
              <WhatsAppIcon client:load class="w-5 h-5 mr-2" />
              WhatsApp Us
            </a>
          </div>
        </div>
      </section>

      {/* Services in this city */}
      <section class="py-20 px-4">
        <div class="container mx-auto max-w-6xl">
          <div class="text-center mb-12">
            <h2 class="font-display font-bold text-4xl text-foreground mb-4">
              Services in {city}
            </h2>
            <p class="text-xl text-muted-foreground max-w-3xl mx-auto">
              Covering {nearbyAreas} and the surrounding {city} area.
            </p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {services.map((service) => (
              <a
                href={`/services/${service.slug}`}
                class="group bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-shadow duration-300 flex flex-col"
              >
                <h3 class="font-display font-bold text-xl text-foreground mb-2">
                  {service.title} in {city}
                </h3>
                <p class="text-muted-foreground mb-4 flex-1">
                  {service.description}
                </p>
                <span class="inline-flex items-center gap-2 text-primary font-semibold group-hover:gap-3 transition-all">
                  Learn more
                  <ArrowRight class="w-4 h-4" />
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>

      {/* Other areas we cover */}
      <section class="py-16 px-4 bg-muted/50">
        <div class="container mx-auto max-w-4xl text-center">
          <h2 class="font-display font-bold text-3xl text-foreground mb-6">
            Other areas we cover
          </h2>
          <div class="flex flex-wrap justify-center gap-4">
            {otherLocations.map((location) => (
              <a
                href={`/${location.slug}`}
                class="inline-flex items-center px-6 py-3 bg-white rounded-full font-semibold text-primary border border-primary/20 hover:bg-primary hover:text-white transition-colors"
              >
                Decking & Fencing in {location.name}
              </a>
            ))}
            <a
              href="/locations"
              class="inline-flex items-center px-6 py-3 bg-white rounded-full font-semibold text-primary border border-primary/20 hover:bg-primary hover:text-white transition-colors"
            >
              View all areas
            </a>
          </div>
        </div>
      </section>

      {/* FAQ Section */}
      <section class="py-20 px-4">
        <div class="container mx-auto max-w-4xl">
          <div class="text-center mb-12">
            <h2 class="font-display font-bold text-4xl text-foreground mb-4">
              {city} — Frequently Asked Questions
            </h2>
          </div>
          <div class="space-y-4">
            {faqs.map((faq) => (
              <div class="bg-white rounded-2xl p-6 shadow-lg">
                <h3 class="font-semibold text-lg text-foreground mb-2">
                  {faq.question}
                </h3>
                <p class="text-muted-foreground leading-relaxed">
                  {faq.answer}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* CTA Section */}
      <section class="py-16 px-4 bg-primary text-white">
        <div class="container mx-auto max-w-4xl text-center">
          <h2 class="font-display font-bold text-4xl mb-4">
            Ready to Transform Your {city} Garden?
          </h2>
          <p class="text-xl mb-8 opacity-90">
            Get your free quote today and join hundreds of satisfied {city} customers
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="tel:+447949912201"
              data-track-source="stirling_cta"
              class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary rounded-full font-semibold hover:bg-gray-100 transition-colors phone-link"
            >
              <Phone class="w-5 h-5 mr-2" />
              Call 07949 912201
            </a>
            <a
              href="https://wa.me/447949912201"
              target="_blank"
              rel="noopener noreferrer"
              data-track-source="stirling_cta"
              class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white rounded-full font-semibold hover:bg-white hover:text-primary transition-colors whatsapp-link"
            >
              <WhatsAppIcon client:load class="w-5 h-5 mr-2" />
              WhatsApp Us
            </a>
          </div>
        </div>
      </section>
    </div>
    <Footer client:load />
  </Providers>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(placeSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>

<script>
  import { trackPageView, trackPhoneCall, trackMessenger } from '@/utils/analytics';

  if (typeof window !== 'undefined') {
    trackPageView(window.location.pathname, document.title);

    document.querySelectorAll('.phone-link').forEach(link => {
      link.addEventListener('click', () => {
        const source = link.getAttribute('data-track-source') || 'unknown';
        trackPhoneCall(source);
      });
    });

    document.querySelectorAll('.whatsapp-link').forEach(link => {
      link.addEventListener('click', () => {
        const source = link.getAttribute('data-track-source') || 'unknown';
        trackMessenger(source);
      });
    });
  }
</script>
