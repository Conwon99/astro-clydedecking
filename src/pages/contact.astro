---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import ContactForm from '@/components/ContactForm';
import Footer from '@/components/Footer';
import Providers from '@/components/Providers';
import BreadcrumbSchema from '@/components/BreadcrumbSchema.astro';
import { business, absoluteUrl } from '@/data/business';
import { contactFaqs, buildFaqSchema } from '@/data/faqs';

const canonical = absoluteUrl('/contact');
const title = `Contact Us | Get Your Free Quote | ${business.alternateName}`;
const description = `Contact ${business.alternateName} for a free decking or fencing quote in Glasgow, Edinburgh, Stirling & the Central Belt. Call ${business.phoneLocal} or use our contact form.`;

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": ["WebPage", "ContactPage"],
  "@id": `${canonical}#webpage`,
  name: title,
  description,
  url: canonical,
  inLanguage: "en-GB",
  about: { "@id": `${business.siteUrl}/#business` },
};

const faqSchema = buildFaqSchema(contactFaqs);
---

<Layout title={title} description={description} canonical={canonical}>
  <Providers client:load>
    <div class="min-h-screen bg-background">
      <Navigation client:load />

      <main id="main-content">

      {/* Hero Section */}
      <section class="relative py-20 px-4 pt-32 bg-gradient-to-br from-primary/10 to-primary/5">
        <div class="container mx-auto max-w-4xl">
          <div class="text-center mb-12">
            <h1 class="font-display font-bold text-4xl lg:text-5xl text-foreground mb-6">
              Get Your <span class="text-primary">Free Quote</span>
            </h1>
            <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
              Fill out the form below and we'll get back to you within 24 hours with a free, no-obligation quote for your decking or fencing project.
            </p>
          </div>
        </div>
      </section>

      {/* Contact Form Section */}
      <section class="py-16 px-4">
        <div class="container mx-auto max-w-4xl">
          <ContactForm client:load />
        </div>
      </section>

      {/* FAQs */}
      <section class="py-16 px-4 bg-muted/30">
        <div class="container mx-auto max-w-4xl">
          <h2 class="font-display font-bold text-3xl text-foreground mb-8 text-center">
            Contact FAQs
          </h2>
          <div class="space-y-4">
            {contactFaqs.map((faq) => (
              <div class="bg-white rounded-lg p-6 shadow-sm">
                <h3 class="font-semibold text-lg text-foreground mb-2">{faq.question}</h3>
                <p class="text-muted-foreground">{faq.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      </main>

      <Footer client:load />
    </div>
  </Providers>

  <script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbSchema items={[
    { name: 'Home', href: '/' },
    { name: 'Contact', href: '/contact' },
  ]} />

  <script>
    import { trackPageView } from '@/utils/analytics';

    if (typeof window !== 'undefined') {
      trackPageView(window.location.pathname, document.title);
    }
  </script>
</Layout>
