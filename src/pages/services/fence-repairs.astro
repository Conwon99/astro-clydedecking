---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import Footer from '@/components/Footer';
import Providers from '@/components/Providers';
import { CheckCircle, Star, MapPin, Phone, ArrowRight } from 'lucide-react';
import LazyImage from '@/components/LazyImage';
---

<Layout
  title="Fence Repairs Services | Glasgow & Central Belt | Clyde Decking"
  description="Expert fence repair and maintenance services in Glasgow, Edinburgh, Stirling & Ayrshire. Quick repairs, post replacement, panel fixing. Free quotes available."
  canonical="https://clydedeckingsolutionsltd.com/services/fence-repairs"
>
  <Providers client:load>
    <div class="min-h-screen bg-background">
      <Navigation client:load />
      
      <section class="relative py-24 px-4 pt-32 bg-gradient-to-br from-primary/10 via-primary/5 to-background">
        <div class="container mx-auto max-w-6xl">
          <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div>
              <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-6">
                Fence Repairs
              </h1>
              <h2 class="text-2xl md:text-3xl text-muted-foreground mb-8">
                Glasgow & Central Belt
              </h2>
              <p class="text-xl text-muted-foreground leading-relaxed mb-8">
                Expert repair and maintenance services for existing fences. Quick repairs, 
                post replacement, panel fixing, and maintenance advice to restore your 
                fence to perfect condition.
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-bold text-lg rounded-xl transition-colors duration-200">
                  Get a Free Quote
                </a>
                <a href="tel:+447949912201" class="inline-flex items-center justify-center px-8 py-4 border-2 border-primary text-primary hover:bg-primary hover:text-white font-semibold text-lg rounded-xl transition-colors duration-200">
                  <Phone class="w-5 h-5 mr-2" />
                  Call 07949 912201
                </a>
              </div>
            </div>
            <div class="relative">
              <div class="rounded-2xl overflow-hidden shadow-2xl">
                <LazyImage client:load src="/gallery/imgi_8_gallery 3.jpg" alt="Professional fence repair services" className="w-full h-auto" />
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-20 px-4 bg-white">
        <div class="container mx-auto max-w-6xl">
          <div class="text-center mb-16">
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground mb-6">
              Our Repair Services
            </h2>
            <p class="text-xl text-muted-foreground max-w-3xl mx-auto">
              Comprehensive fence repair solutions to restore your fence's functionality and appearance.
            </p>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/imgi_8_gallery 3.jpg" alt="Quick fence repairs" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Quick Repairs</h3>
                <p class="text-muted-foreground">Fast response for urgent fence repairs to restore security and privacy quickly.</p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/Fence1.jpg" alt="Post replacement fence repairs" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Post Replacement</h3>
                <p class="text-muted-foreground">Replace damaged or rotted posts to restore structural integrity to your fence.</p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/imgi_7_gallery 2.jpg" alt="Panel fixing fence repairs" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Panel Fixing</h3>
                <p class="text-muted-foreground">Repair or replace damaged panels to restore your fence's appearance and function.</p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/imgi_8_gallery 3.jpg" alt="Gate repairs" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Gate Repairs</h3>
                <p class="text-muted-foreground">Fix sagging gates, replace hinges, and restore proper gate operation.</p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/Fence1.jpg" alt="Fence maintenance advice" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Maintenance Advice</h3>
                <p class="text-muted-foreground">Expert guidance on maintaining your fence to prevent future issues.</p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/imgi_7_gallery 2.jpg" alt="Storm damage fence repairs" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Storm Damage</h3>
                <p class="text-muted-foreground">Emergency repairs for storm-damaged fences to restore security quickly.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-20 px-4 bg-primary text-white">
        <div class="container mx-auto max-w-4xl text-center">
          <h2 class="font-display text-3xl md:text-4xl font-bold mb-6">Need Fence Repairs?</h2>
          <p class="text-xl text-white/90 mb-8">Get a free quote for expert fence repair services.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary hover:bg-gray-100 font-bold text-lg rounded-xl transition-colors duration-200">
              Get a Free Quote
              <ArrowRight client:load class="w-5 h-5 ml-2" />
            </a>
            <a href="tel:+447949912201" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white hover:bg-white hover:text-primary font-semibold text-lg rounded-xl transition-colors duration-200">
              <Phone client:load class="w-5 h-5 mr-2" />
              Call 07949 912201
            </a>
          </div>
        </div>
      </section>

      <Footer client:load />
    </div>
  </Providers>
</Layout>

<script>
  import { trackPageView } from '@/utils/analytics';
  if (typeof window !== 'undefined') {
    trackPageView(window.location.pathname, document.title);
  }
</script>

