---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import Footer from '@/components/Footer';
import Providers from '@/components/Providers';
import { CheckCircle, Star, MapPin, Phone, ArrowRight } from 'lucide-react';
import LazyImage from '@/components/LazyImage';
---

<Layout
  title="Composite Decking Services | Glasgow & Central Belt | Clyde Decking"
  description="Professional composite decking installation in Glasgow, Edinburgh, Stirling & Ayrshire. Low maintenance, weather-resistant composite decking solutions. Free quotes available."
  canonical="https://clydedeckingsolutionsltd.com/services/composite-decking"
>
  <Providers client:load>
    <div class="min-h-screen bg-background">
      <Navigation client:load />
      
      {/* Hero Section */}
      <section class="relative py-24 px-4 pt-32 bg-gradient-to-br from-primary/10 via-primary/5 to-background">
        <div class="container mx-auto max-w-6xl">
          <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div>
              <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-6">
                Composite Decking
              </h1>
              <h2 class="text-2xl md:text-3xl text-muted-foreground mb-8">
                Glasgow & Central Belt
              </h2>
              <p class="text-xl text-muted-foreground leading-relaxed mb-8">
                Transform your outdoor space with high-quality composite decking. 
                Low maintenance, weather-resistant, and built to last. Perfect for modern 
                homes across Glasgow, Edinburgh, Stirling, and Ayrshire.
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                <a
                  href="/contact"
                  class="inline-flex items-center justify-center px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-bold text-lg rounded-xl transition-colors duration-200"
                >
                  Get a Free Quote
                </a>
              </div>
            </div>
            <div class="relative">
              <div class="rounded-2xl overflow-hidden shadow-2xl">
                <LazyImage
                  client:load
                  src="/gallery/imgi_4_gallery 7.jpg"
                  alt="Professional composite decking installation in Glasgow and Central Belt"
                  className="w-full h-auto"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Benefits Section */}
      <section class="py-20 px-4 bg-white">
        <div class="container mx-auto max-w-6xl">
          <div class="text-center mb-16">
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground mb-6">
              Why Choose Composite Decking?
            </h2>
            <p class="text-xl text-muted-foreground max-w-3xl mx-auto">
              Composite decking offers the perfect combination of durability, low maintenance, 
              and modern aesthetics for your outdoor space.
            </p>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/imgi_4_gallery 7.jpg" alt="Low maintenance composite decking" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Low Maintenance</h3>
                <p class="text-muted-foreground">
                  No staining, sealing, or sanding required. Simply clean with soap and water 
                  to keep your deck looking like new.
                </p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/deck1.jpg" alt="Weather resistant composite decking" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Weather Resistant</h3>
                <p class="text-muted-foreground">
                  Built to withstand Scotland's climate. Resistant to rot, mold, and fading, 
                  even in harsh weather conditions.
                </p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/deck2.jpg" alt="Long-lasting composite decking" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Long-Lasting</h3>
                <p class="text-muted-foreground">
                  Designed to last for decades with minimal upkeep. A long-term investment 
                  in your outdoor living space.
                </p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/deck3.jpg" alt="Modern design composite decking" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Modern Design</h3>
                <p class="text-muted-foreground">
                  Contemporary appearance with a variety of colors and finishes to match 
                  your home's aesthetic.
                </p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/imgi_4_gallery 7.jpg" alt="Eco-friendly composite decking" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Eco-Friendly</h3>
                <p class="text-muted-foreground">
                  Made from recycled materials, composite decking is an environmentally 
                  responsible choice for your home.
                </p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/deck1.jpg" alt="Slip resistant composite decking" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Slip Resistant</h3>
                <p class="text-muted-foreground">
                  Textured surface provides excellent grip, making it safe for families 
                  even when wet.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Why Choose Us */}
      <section class="py-20 px-4 bg-muted/30">
        <div class="container mx-auto max-w-6xl">
          <div class="text-center mb-16">
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground mb-6">
              Why Choose Clyde Decking?
            </h2>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
            <div class="text-center">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <Star client:load class="w-8 h-8 text-primary" />
              </div>
              <h3 class="text-xl font-semibold text-foreground mb-3">Expert Installation</h3>
              <p class="text-muted-foreground">
                Professional installation by experienced decking specialists.
              </p>
            </div>

            <div class="text-center">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <MapPin client:load class="w-8 h-8 text-primary" />
              </div>
              <h3 class="text-xl font-semibold text-foreground mb-3">Local Expertise</h3>
              <p class="text-muted-foreground">
                Serving Glasgow, Edinburgh, Stirling & Ayrshire with local knowledge.
              </p>
            </div>

            <div class="text-center">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <CheckCircle client:load class="w-8 h-8 text-primary" />
              </div>
              <h3 class="text-xl font-semibold text-foreground mb-3">Quality Materials</h3>
              <p class="text-muted-foreground">
                Premium composite decking from trusted manufacturers.
              </p>
            </div>

            <div class="text-center">
              <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
                <Phone client:load class="w-8 h-8 text-primary" />
              </div>
              <h3 class="text-xl font-semibold text-foreground mb-3">Free Quotes</h3>
              <p class="text-muted-foreground">
                No-obligation quotes with transparent pricing.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* CTA Section */}
      <section class="py-20 px-4 bg-primary text-white">
        <div class="container mx-auto max-w-4xl text-center">
          <h2 class="font-display text-3xl md:text-4xl font-bold mb-6">
            Ready to Install Composite Decking?
          </h2>
          <p class="text-xl text-white/90 mb-8">
            Get a free quote for professional composite decking installation. 
            Transform your outdoor space with low-maintenance, long-lasting decking.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/contact"
              class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary hover:bg-gray-100 font-bold text-lg rounded-xl transition-colors duration-200"
            >
              Get a Free Quote
              <ArrowRight client:load class="w-5 h-5 ml-2" />
            </a>
          </div>
        </div>
      </section>

      <Footer client:load />
    </div>
  </Providers>
</Layout>

<script>
  import { trackPageView } from '@/utils/analytics';
  
  if (typeof window !== 'undefined') {
    trackPageView(window.location.pathname, document.title);
  }
</script>

