---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import Footer from '@/components/Footer';
import Providers from '@/components/Providers';
import BreadcrumbSchema from '@/components/BreadcrumbSchema.astro';
import { CheckCircle, Star, MapPin, Phone, ArrowRight } from 'lucide-react';
import LazyImage from '@/components/LazyImage';
import { services, getServiceBySlug } from '@/data/services';
import { getCategoryBySlug } from '@/data/categories';
import { business, absoluteUrl } from '@/data/business';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const category = getCategoryBySlug(service.parentCategorySlug);

const pageTitle = `${service.title} Services | Glasgow & Central Belt | Clyde Decking`;
const canonical = absoluteUrl(`/services/${service.slug}`);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${canonical}#service`,
  name: service.title,
  description: service.description,
  url: canonical,
  provider: { "@id": `${business.siteUrl}/#business` },
  areaServed: { "@type": "Place", name: business.region },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: service.faq.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<Layout
  title={pageTitle}
  description={service.description}
  canonical={canonical}
>
  <Providers client:load>
    <div class="min-h-screen bg-background">
      <Navigation client:load />

      {/* Hero Section */}
      <section class="relative py-24 px-4 pt-32 bg-gradient-to-br from-primary/10 via-primary/5 to-background">
        <div class="container mx-auto max-w-6xl">
          <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div>
              <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-6">
                {service.title}
              </h1>
              <h2 class="text-2xl md:text-3xl text-muted-foreground mb-8">
                Glasgow & Central Belt
              </h2>
              <p class="text-xl text-muted-foreground leading-relaxed mb-8">
                {service.about}
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                <a
                  href="/contact"
                  class="inline-flex items-center justify-center px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-bold text-lg rounded-xl transition-colors duration-200"
                >
                  Get a Free Quote
                </a>
                <a
                  href={business.phoneTel}
                  class="inline-flex items-center justify-center px-8 py-4 border-2 border-primary text-primary hover:bg-primary hover:text-white font-semibold text-lg rounded-xl transition-colors duration-200"
                >
                  <Phone class="w-5 h-5 mr-2" />
                  Call {business.phoneLocal}
                </a>
              </div>
            </div>
            <div class="relative">
              <div class="rounded-2xl overflow-hidden shadow-2xl">
                <LazyImage
                  client:load
                  src={service.image}
                  alt={service.imageAlt}
                  className="w-full h-auto"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Benefits Section */}
      <section class="py-20 px-4 bg-white">
        <div class="container mx-auto max-w-6xl">
          <div class="text-center mb-16">
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground mb-6">
              {service.whyChooseUs}
            </h2>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {service.benefits.map((benefit) => (
              <div class="bg-muted/50 rounded-xl overflow-hidden">
                <div class="aspect-video overflow-hidden">
                  <LazyImage client:load src={service.image} alt={benefit.title} className="w-full h-full object-cover" />
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-semibold text-foreground mb-3">{benefit.title}</h3>
                  <p class="text-muted-foreground">{benefit.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Process Section */}
      <section class="py-20 px-4 bg-muted/30">
        <div class="container mx-auto max-w-4xl">
          <div class="text-center mb-16">
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground mb-6">
              What to Expect
            </h2>
          </div>
          <ol class="space-y-6">
            {service.process.map((step, index) => (
              <li class="flex items-start gap-4">
                <span class="flex-shrink-0 w-10 h-10 rounded-full bg-primary text-white font-bold flex items-center justify-center">
                  {index + 1}
                </span>
                <p class="text-lg text-muted-foreground pt-1">{step}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      {/* FAQ Section */}
      <section class="py-20 px-4 bg-white">
        <div class="container mx-auto max-w-4xl">
          <div class="text-center mb-16">
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground mb-6">
              Frequently Asked Questions
            </h2>
          </div>
          <div class="space-y-4">
            {service.faq.map((faq) => (
              <div class="bg-muted/50 rounded-lg p-6">
                <h3 class="font-semibold text-lg text-foreground mb-2">{faq.question}</h3>
                <p class="text-muted-foreground">{faq.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* CTA Section */}
      <section class="py-20 px-4 bg-primary text-white">
        <div class="container mx-auto max-w-4xl text-center">
          <h2 class="font-display text-3xl md:text-4xl font-bold mb-6">
            Ready to Get Started?
          </h2>
          <p class="text-xl text-white/90 mb-8">
            Get a free quote for professional {service.title.toLowerCase()}. Transform your outdoor space today.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/contact"
              class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary hover:bg-gray-100 font-bold text-lg rounded-xl transition-colors duration-200"
            >
              Get a Free Quote
              <ArrowRight client:load class="w-5 h-5 ml-2" />
            </a>
            <a
              href={business.phoneTel}
              class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white hover:bg-white hover:text-primary font-semibold text-lg rounded-xl transition-colors duration-200"
            >
              <Phone client:load class="w-5 h-5 mr-2" />
              Call {business.phoneLocal}
            </a>
          </div>
          {category && (
            <p class="mt-8 text-white/80">
              Part of our <a href={`/${category.slug}`} class="underline hover:text-white">{category.name}</a> services
            </p>
          )}
        </div>
      </section>

      <Footer client:load />
    </div>
  </Providers>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<BreadcrumbSchema items={[
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: service.title, href: `/services/${service.slug}` },
]} />

<script>
  import { trackPageView } from '@/utils/analytics';

  if (typeof window !== 'undefined') {
    trackPageView(window.location.pathname, document.title);
  }
</script>
