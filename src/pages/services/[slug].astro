---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import Footer from '@/components/Footer';
import Providers from '@/components/Providers';
import BreadcrumbSchema from '@/components/BreadcrumbSchema.astro';
import { Phone, ArrowRight } from 'lucide-react';
import LazyImage from '@/components/LazyImage';
import { services, getServiceBySlug, getRelatedServices } from '@/data/services';
import { getCategoryBySlug } from '@/data/categories';
import { business, absoluteUrl } from '@/data/business';
import { buildFaqSchema } from '@/data/faqs';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const category = getCategoryBySlug(service.parentCategorySlug);
const relatedServices = getRelatedServices(service.slug, 3);

const pageTitle = `${service.title} in ${business.primaryCity} & ${business.secondaryCity} | ${business.alternateName}`;
const canonical = absoluteUrl(`/services/${service.slug}`);

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  name: pageTitle,
  description: service.description,
  url: canonical,
  inLanguage: "en-GB",
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${canonical}#service`,
  name: service.title,
  description: service.description,
  url: canonical,
  provider: { "@id": `${business.siteUrl}/#business` },
  areaServed: { "@type": "Place", name: business.region },
};

const faqSchema = buildFaqSchema(service.faq);
---

<Layout
  title={pageTitle}
  description={service.description}
  canonical={canonical}
>
  <Providers client:load>
    <div class="min-h-screen bg-background">
      <Navigation client:load />

      <main id="main-content">

      {/* Hero Section */}
      <section class="relative py-24 px-4 pt-32 bg-gradient-to-br from-primary/10 via-primary/5 to-background">
        <div class="container mx-auto max-w-6xl">
          <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div>
              <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-6">
                {service.title} in {business.primaryCity} and {business.secondaryCity}
              </h1>
              <p class="text-xl text-muted-foreground leading-relaxed mb-8">
                {service.about}
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                <a
                  href="/contact"
                  class="inline-flex items-center justify-center px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-bold text-lg rounded-xl transition-colors duration-200"
                >
                  Get a Free Quote
                </a>
                <a
                  href={business.phoneTel}
                  class="inline-flex items-center justify-center px-8 py-4 border-2 border-primary text-primary hover:bg-primary hover:text-white font-semibold text-lg rounded-xl transition-colors duration-200"
                >
                  <Phone class="w-5 h-5 mr-2" />
                  Call {business.phoneLocal}
                </a>
              </div>
            </div>
            <div class="relative">
              <div class="rounded-2xl overflow-hidden shadow-2xl">
                <LazyImage
                  client:load
                  src={service.image}
                  alt={service.imageAlt}
                  className="w-full h-auto"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* 1. About */}
      <section class="py-16 px-4 bg-white">
        <div class="container mx-auto max-w-4xl">
          <h2 class="font-display text-3xl font-bold text-foreground mb-4">About {service.title}</h2>
          <p class="text-lg text-muted-foreground leading-relaxed">{service.about}</p>
        </div>
      </section>

      {/* 2. Signs you need it */}
      <section class="py-16 px-4 bg-muted/30">
        <div class="container mx-auto max-w-4xl">
          <h2 class="font-display text-3xl font-bold text-foreground mb-4">Signs You Need {service.title}</h2>
          <p class="text-lg text-muted-foreground leading-relaxed">{service.signsYouNeed}</p>
        </div>
      </section>

      {/* 3. Our options */}
      <section class="py-16 px-4 bg-white">
        <div class="container mx-auto max-w-4xl">
          <h2 class="font-display text-3xl font-bold text-foreground mb-4">Our {service.title} Options</h2>
          <p class="text-lg text-muted-foreground leading-relaxed">{service.options}</p>
        </div>
      </section>

      {/* 4. Local context */}
      <section class="py-16 px-4 bg-muted/30">
        <div class="container mx-auto max-w-4xl">
          <h2 class="font-display text-3xl font-bold text-foreground mb-4">
            {service.title} for {business.primaryCity} &amp; {business.secondaryCity} Homes
          </h2>
          <p class="text-lg text-muted-foreground leading-relaxed">{service.localContext}</p>
        </div>
      </section>

      {/* 5. What to expect */}
      <section class="py-16 px-4 bg-white">
        <div class="container mx-auto max-w-4xl">
          <h2 class="font-display text-3xl font-bold text-foreground mb-8">What to Expect</h2>
          <ol class="space-y-6">
            {service.process.map((step, index) => (
              <li class="flex items-start gap-4">
                <span class="flex-shrink-0 w-10 h-10 rounded-full bg-primary text-white font-bold flex items-center justify-center">
                  {index + 1}
                </span>
                <p class="text-lg text-muted-foreground pt-1">{step}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      {/* 6. Why choose us */}
      <section class="py-16 px-4 bg-muted/30">
        <div class="container mx-auto max-w-6xl">
          <h2 class="font-display text-3xl font-bold text-foreground mb-4">Why Choose Us for {service.title}</h2>
          <p class="text-lg text-muted-foreground leading-relaxed mb-10 max-w-3xl">{service.whyChooseUs}</p>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {service.benefits.map((benefit) => (
              <div class="bg-white rounded-xl overflow-hidden">
                <div class="aspect-video overflow-hidden">
                  <LazyImage client:load src={service.image} alt={benefit.title} className="w-full h-full object-cover" />
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-semibold text-foreground mb-3">{benefit.title}</h3>
                  <p class="text-muted-foreground">{benefit.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* 7. FAQs */}
      <section class="py-16 px-4 bg-white">
        <div class="container mx-auto max-w-4xl">
          <h2 class="font-display text-3xl font-bold text-foreground mb-8">{service.title} FAQs</h2>
          <div class="space-y-4">
            {service.faq.map((faq) => (
              <div class="bg-muted/50 rounded-lg p-6">
                <h3 class="font-semibold text-lg text-foreground mb-2">{faq.question}</h3>
                <p class="text-muted-foreground">{faq.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Related services */}
      {relatedServices.length > 0 && (
        <section class="py-16 px-4 bg-muted/30">
          <div class="container mx-auto max-w-6xl">
            <h2 class="font-display text-2xl font-bold text-foreground mb-8">Related Services</h2>
            <div class="grid md:grid-cols-3 gap-6">
              {relatedServices.map((related) => (
                <a href={`/services/${related.slug}`} class="group block bg-white rounded-xl overflow-hidden shadow hover:shadow-lg transition-shadow">
                  <div class="aspect-video overflow-hidden">
                    <LazyImage client:load src={related.image} alt={related.imageAlt} className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                  </div>
                  <div class="p-5">
                    <h3 class="text-lg font-semibold text-foreground mb-1">{related.title}</h3>
                    <p class="text-muted-foreground text-sm">{related.cardDescription}</p>
                  </div>
                </a>
              ))}
            </div>
            {category && (
              <p class="mt-8">
                <a href={`/${category.slug}`} class="text-primary hover:underline font-semibold">
                  ← Back to {category.name}
                </a>
              </p>
            )}
          </div>
        </section>
      )}

      {/* CTA Section */}
      <section class="py-20 px-4 bg-primary text-white">
        <div class="container mx-auto max-w-4xl text-center">
          <h2 class="font-display text-3xl md:text-4xl font-bold mb-6">
            Ready to Get Started?
          </h2>
          <p class="text-xl text-white/90 mb-8">
            Get a free quote for professional {service.title.toLowerCase()}. Transform your outdoor space today.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/contact"
              class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary hover:bg-gray-100 font-bold text-lg rounded-xl transition-colors duration-200"
            >
              Get a Free Quote
              <ArrowRight client:load class="w-5 h-5 ml-2" />
            </a>
            <a
              href={business.phoneTel}
              class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white hover:bg-white hover:text-primary font-semibold text-lg rounded-xl transition-colors duration-200"
            >
              <Phone client:load class="w-5 h-5 mr-2" />
              Call {business.phoneLocal}
            </a>
          </div>
        </div>
      </section>

      </main>

      <Footer client:load />
    </div>
  </Providers>

  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <BreadcrumbSchema items={[
    { name: 'Home', href: '/' },
    { name: 'Services', href: '/services' },
    ...(category ? [{ name: category.name, href: `/${category.slug}` }] : []),
    { name: service.title, href: `/services/${service.slug}` },
  ]} />

  <script>
    import { trackPageView } from '@/utils/analytics';

    if (typeof window !== 'undefined') {
      trackPageView(window.location.pathname, document.title);
    }
  </script>
</Layout>
