---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import Footer from '@/components/Footer';
import Providers from '@/components/Providers';
import { CheckCircle, Star, MapPin, ArrowRight } from 'lucide-react';
import LazyImage from '@/components/LazyImage';
---

<Layout
  title="Fencing Installation Services | Glasgow & Central Belt | Clyde Decking"
  description="Professional fencing installation in Glasgow, Edinburgh, Stirling & Ayrshire. Various materials, custom heights, secure installation. Free quotes available."
  canonical="https://clydedeckingsolutionsltd.com/services/fencing-installation"
>
  <Providers client:load>
    <div class="min-h-screen bg-background">
      <Navigation client:load />
      
      <section class="relative py-24 px-4 pt-32 bg-gradient-to-br from-primary/10 via-primary/5 to-background">
        <div class="container mx-auto max-w-6xl">
          <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div>
              <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-6">
                Fencing Installation
              </h1>
              <h2 class="text-2xl md:text-3xl text-muted-foreground mb-8">
                Glasgow & Central Belt
              </h2>
              <p class="text-xl text-muted-foreground leading-relaxed mb-8">
                Professional fencing solutions for privacy, security, and boundary definition. 
                Various materials, custom heights, and secure installation across Glasgow, 
                Edinburgh, Stirling, and Ayrshire.
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-bold text-lg rounded-xl transition-colors duration-200">
                  Get a Free Quote
                </a>
              </div>
            </div>
            <div class="relative">
              <div class="rounded-2xl overflow-hidden shadow-2xl">
                <LazyImage client:load src="/gallery/imgi_7_gallery 2.jpg" alt="Professional fencing installation" className="w-full h-auto" />
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-20 px-4 bg-white">
        <div class="container mx-auto max-w-6xl">
          <div class="text-center mb-16">
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground mb-6">
              Our Fencing Services
            </h2>
            <p class="text-xl text-muted-foreground max-w-3xl mx-auto">
              Comprehensive fencing solutions tailored to your needs.
            </p>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/imgi_7_gallery 2.jpg" alt="Various materials fencing installation" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Various Materials</h3>
                <p class="text-muted-foreground">Wood, composite, metal, and vinyl fencing options to suit your style and budget.</p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/Fence1.jpg" alt="Custom heights fencing installation" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Custom Heights</h3>
                <p class="text-muted-foreground">Fencing installed to your exact specifications for privacy and security needs.</p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/imgi_8_gallery 3.jpg" alt="Secure installation fencing" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Secure Installation</h3>
                <p class="text-muted-foreground">Properly installed posts and panels ensuring long-lasting stability and security.</p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/imgi_7_gallery 2.jpg" alt="Weather protection fencing" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Weather Protection</h3>
                <p class="text-muted-foreground">Materials and treatments designed to withstand Scotland's climate conditions.</p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/Fence1.jpg" alt="Gates included fencing" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Gates Included</h3>
                <p class="text-muted-foreground">Custom gates matching your fence design for complete boundary solutions.</p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/imgi_8_gallery 3.jpg" alt="Professional finish fencing" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Professional Finish</h3>
                <p class="text-muted-foreground">Expert installation with attention to detail for a polished, professional appearance.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-20 px-4 bg-primary text-white">
        <div class="container mx-auto max-w-4xl text-center">
          <h2 class="font-display text-3xl md:text-4xl font-bold mb-6">Need New Fencing?</h2>
          <p class="text-xl text-white/90 mb-8">Get a free quote for professional fencing installation.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary hover:bg-gray-100 font-bold text-lg rounded-xl transition-colors duration-200">
              Get a Free Quote
              <ArrowRight client:load class="w-5 h-5 ml-2" />
            </a>
          </div>
        </div>
      </section>

      <Footer client:load />
    </div>
  </Providers>
</Layout>

<script>
  import { trackPageView } from '@/utils/analytics';
  if (typeof window !== 'undefined') {
    trackPageView(window.location.pathname, document.title);
  }
</script>

