---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import Footer from '@/components/Footer';
import Providers from '@/components/Providers';
import { CheckCircle, Star, MapPin, ArrowRight } from 'lucide-react';
import LazyImage from '@/components/LazyImage';
---

<Layout
  title="Wooden Decking Services | Glasgow & Central Belt | Clyde Decking"
  description="Professional wooden decking installation in Glasgow, Edinburgh, Stirling & Ayrshire. Traditional wooden decking with expert craftsmanship. Free quotes available."
  canonical="https://clydedeckingsolutionsltd.com/services/wooden-decking"
>
  <Providers client:load>
    <div class="min-h-screen bg-background">
      <Navigation client:load />
      
      <section class="relative py-24 px-4 pt-32 bg-gradient-to-br from-primary/10 via-primary/5 to-background">
        <div class="container mx-auto max-w-6xl">
          <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div>
              <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-6">
                Wooden Decking
              </h1>
              <h2 class="text-2xl md:text-3xl text-muted-foreground mb-8">
                Glasgow & Central Belt
              </h2>
              <p class="text-xl text-muted-foreground leading-relaxed mb-8">
                Traditional wooden decking with expert craftsmanship. Natural beauty, 
                custom designs, and professional installation for homes across Glasgow, 
                Edinburgh, Stirling, and Ayrshire.
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-bold text-lg rounded-xl transition-colors duration-200">
                  Get a Free Quote
                </a>
              </div>
            </div>
            <div class="relative">
              <div class="rounded-2xl overflow-hidden shadow-2xl">
                <LazyImage client:load src="/gallery/imgi_5_gallery 6.jpg" alt="Professional wooden decking installation" className="w-full h-auto" />
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-20 px-4 bg-white">
        <div class="container mx-auto max-w-6xl">
          <div class="text-center mb-16">
            <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground mb-6">
              Why Choose Wooden Decking?
            </h2>
            <p class="text-xl text-muted-foreground max-w-3xl mx-auto">
              Wooden decking offers natural beauty, warmth, and timeless appeal for your outdoor space.
            </p>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/imgi_5_gallery 6.jpg" alt="Natural beauty wooden decking" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Natural Beauty</h3>
                <p class="text-muted-foreground">Classic wooden appearance that complements any garden design with warmth and character.</p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/deck1.jpg" alt="Custom designs wooden decking" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Custom Designs</h3>
                <p class="text-muted-foreground">Tailored to your space with various wood types, finishes, and layout options.</p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/deck2.jpg" alt="Quality materials wooden decking" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Quality Materials</h3>
                <p class="text-muted-foreground">Premium hardwoods and treated softwoods selected for durability and appearance.</p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/deck3.jpg" alt="Professional installation wooden decking" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Professional Installation</h3>
                <p class="text-muted-foreground">Expert craftsmanship ensuring proper drainage, support, and finishing.</p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/imgi_5_gallery 6.jpg" alt="Versatile wooden decking" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Versatile</h3>
                <p class="text-muted-foreground">Suitable for various applications from ground-level decks to elevated platforms.</p>
              </div>
            </div>

            <div class="bg-muted/50 rounded-xl overflow-hidden">
              <div class="aspect-video overflow-hidden">
                <LazyImage client:load src="/gallery/deck1.jpg" alt="Cost-effective wooden decking" className="w-full h-full object-cover" />
              </div>
              <div class="p-6">
                <h3 class="text-xl font-semibold text-foreground mb-3">Cost-Effective</h3>
                <p class="text-muted-foreground">Excellent value for money with proper maintenance extending its lifespan significantly.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-20 px-4 bg-primary text-white">
        <div class="container mx-auto max-w-4xl text-center">
          <h2 class="font-display text-3xl md:text-4xl font-bold mb-6">Ready for Wooden Decking?</h2>
          <p class="text-xl text-white/90 mb-8">Get a free quote for professional wooden decking installation.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary hover:bg-gray-100 font-bold text-lg rounded-xl transition-colors duration-200">
              Get a Free Quote
              <ArrowRight client:load class="w-5 h-5 ml-2" />
            </a>
          </div>
        </div>
      </section>

      <Footer client:load />
    </div>
  </Providers>
</Layout>

<script>
  import { trackPageView } from '@/utils/analytics';
  if (typeof window !== 'undefined') {
    trackPageView(window.location.pathname, document.title);
  }
</script>

