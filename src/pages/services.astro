---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import Footer from '@/components/Footer';
import Providers from '@/components/Providers';
import BreadcrumbSchema from '@/components/BreadcrumbSchema.astro';
import { ArrowRight } from 'lucide-react';
import LazyImage from '@/components/LazyImage';
import { categories } from '@/data/categories';
import { getServicesForCategory } from '@/data/services';
import { business, absoluteUrl } from '@/data/business';

const canonical = absoluteUrl('/services');
const title = `Our Services | ${business.alternateName}`;
const description = `Composite decking, timber decking, fencing installation and repairs across ${business.primaryCity}, ${business.secondaryCity} and the Central Belt. Free, no-obligation quotes.`;

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  name: title,
  description,
  url: canonical,
  inLanguage: "en-GB",
};
---

<Layout title={title} description={description} canonical={canonical}>
  <Providers client:load>
    <div class="min-h-screen bg-background">
      <Navigation client:load />

      <main id="main-content">

      {/* Hero Section */}
      <section class="relative py-24 px-4 pt-32 bg-gradient-to-br from-primary/10 via-primary/5 to-background">
        <div class="container mx-auto max-w-6xl">
          <div class="text-center mb-12">
            <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl text-foreground mb-6">
              Our <span class="text-primary">Services</span>
            </h1>
            <p class="text-xl text-muted-foreground max-w-3xl mx-auto leading-relaxed">
              Professional decking and fencing solutions across Scotland's Central Belt.
              From composite decking to custom outdoor structures, we deliver quality craftsmanship
              and exceptional service.
            </p>
          </div>
        </div>
      </section>

      {/* Services grouped by category */}
      {categories.map((category) => (
        <section class="py-16 px-4 border-t border-border first:border-t-0">
          <div class="container mx-auto max-w-6xl">
            <div class="mb-10">
              <h2 class="font-display text-3xl lg:text-4xl font-bold text-foreground mb-3">
                <a href={`/${category.slug}`} class="hover:text-primary transition-colors">{category.name}</a>
              </h2>
              <p class="text-lg text-muted-foreground max-w-3xl">{category.intro}</p>
            </div>

            <div class="space-y-8">
              {getServicesForCategory(category.slug).map((service, index) => (
                <article
                  class={`flex flex-col ${index % 2 === 0 ? 'lg:flex-row' : 'lg:flex-row-reverse'} gap-8 lg:gap-12 items-center bg-white rounded-2xl p-8 lg:p-12 shadow-lg hover:shadow-xl transition-shadow duration-300`}
                >
                  <div class="flex-1 w-full lg:w-1/2">
                    <div class="relative rounded-xl overflow-hidden aspect-[4/3]">
                      <LazyImage
                        client:load
                        src={service.image}
                        alt={service.imageAlt}
                        className="w-full h-full object-cover"
                      />
                    </div>
                  </div>

                  <div class="flex-1 w-full lg:w-1/2 space-y-6">
                    <div>
                      <h3 class="font-display text-3xl lg:text-4xl font-bold text-foreground mb-4">
                        {service.title}
                      </h3>
                      <p class="text-lg text-muted-foreground leading-relaxed mb-6">
                        {service.cardDescription}
                      </p>
                    </div>

                    <a
                      href={`/services/${service.slug}`}
                      class="inline-flex items-center gap-2 text-primary font-semibold text-lg hover:gap-4 transition-all duration-300 group"
                    >
                      Learn More
                      <ArrowRight client:load class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      ))}

      {/* General Enquiries CTA */}
      <section class="py-20 px-4 bg-primary/5">
        <div class="container mx-auto max-w-4xl text-center">
          <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground mb-6">
            Ready to Start Your Project?
          </h2>
          <p class="text-xl text-muted-foreground mb-8">
            Get a free, no-obligation quote for any of our services.
            Our expert team is ready to help bring your outdoor vision to life.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="/contact"
              class="inline-flex items-center justify-center px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-bold text-lg rounded-xl transition-colors duration-200"
            >
              Get a Free Quote
            </a>
            <a
              href={business.phoneTel}
              class="inline-flex items-center justify-center px-8 py-4 border-2 border-primary text-primary hover:bg-primary hover:text-white font-semibold text-lg rounded-xl transition-colors duration-200"
            >
              Call {business.phoneLocal}
            </a>
          </div>
        </div>
      </section>

      </main>

      <Footer client:load />
    </div>
  </Providers>

  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <BreadcrumbSchema items={[
    { name: 'Home', href: '/' },
    { name: 'Services', href: '/services' },
  ]} />

  <script>
    import { trackPageView } from '@/utils/analytics';

    if (typeof window !== 'undefined') {
      trackPageView(window.location.pathname, document.title);
    }
  </script>
</Layout>
