---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import Footer from '@/components/Footer';
import Providers from '@/components/Providers';
import BreadcrumbSchema from '@/components/BreadcrumbSchema.astro';
import { Facebook, Shield, Award, Users } from 'lucide-react';
import { business, absoluteUrl } from '@/data/business';
import { locations } from '@/data/locations';
import { categories } from '@/data/categories';

const townLocations = locations.filter((l) => l.character === "town");
const canonical = absoluteUrl('/about');

const title = `About Us | ${business.businessName}`;
const description = `Clyde Decking has been installing and repairing composite decking, timber decking, fencing, outdoor structures across Glasgow and the Central Belt since ${business.foundingDate}.`;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  name: title,
  description,
  url: canonical,
  inLanguage: "en-GB",
  about: { "@id": `${business.siteUrl}/#business` },
};
---

<Layout title={title} description={description} canonical={canonical}>
  <Providers client:load>
    <div class="min-h-screen bg-background">
      <Navigation client:load />

      <main id="main-content">

      <section class="relative py-24 px-4 pt-32 bg-gradient-to-br from-primary/10 via-primary/5 to-background">
        <div class="container mx-auto max-w-4xl text-center">
          <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl text-foreground mb-6">
            About <span class="text-primary">{business.alternateName}</span>
          </h1>
          <p class="text-xl text-muted-foreground max-w-3xl mx-auto leading-relaxed">
            Trusted decking and fencing contractors serving Glasgow, Edinburgh, Stirling and Scotland's Central Belt since {business.foundingDate}.
          </p>
        </div>
      </section>

      <section class="py-16 px-4 bg-white">
        <div class="container mx-auto max-w-4xl space-y-12">
          <div>
            <h2 class="font-display font-bold text-3xl text-foreground mb-4">Our Approach</h2>
            <p class="text-lg text-muted-foreground leading-relaxed">
              {business.businessName} is a trusted provider of composite and wooden decking, fencing and custom outdoor
              joinery solutions across Scotland. Our skilled joiners are experts in all aspects of joinery work, ensuring
              every project is completed to the highest standards. We believe in combining functionality with aesthetics
              to create beautiful, durable outdoor spaces - and we back every job with a free, no-obligation quote so
              there are no surprises before work starts.
            </p>
          </div>

          <div>
            <h2 class="font-display font-bold text-3xl text-foreground mb-4">Insurance &amp; Credentials</h2>
            <div class="grid sm:grid-cols-2 gap-6">
              <div class="flex items-start gap-3 p-4 rounded-lg bg-muted/50 border border-border">
                <Shield client:load class="w-6 h-6 text-primary flex-shrink-0 mt-1" />
                <div>
                  <h3 class="font-semibold text-foreground mb-1">Fully Insured</h3>
                  <p class="text-muted-foreground text-sm">Public liability insurance covers every decking and fencing job we carry out.</p>
                </div>
              </div>
              <div class="flex items-start gap-3 p-4 rounded-lg bg-muted/50 border border-border">
                <Award client:load class="w-6 h-6 text-primary flex-shrink-0 mt-1" />
                <div>
                  <h3 class="font-semibold text-foreground mb-1">Since {business.foundingDate}</h3>
                  <p class="text-muted-foreground text-sm">Years of hands-on decking and fencing experience across the Central Belt.</p>
                </div>
              </div>
              <div class="flex items-start gap-3 p-4 rounded-lg bg-muted/50 border border-border">
                <Users client:load class="w-6 h-6 text-primary flex-shrink-0 mt-1" />
                <div>
                  <h3 class="font-semibold text-foreground mb-1">Free, No-Obligation Quotes</h3>
                  <p class="text-muted-foreground text-sm">Every project starts with a transparent, free quote - no hidden costs.</p>
                </div>
              </div>
            </div>
          </div>

          <div>
            <h2 class="font-display font-bold text-3xl text-foreground mb-4">Proudly Serving {business.primaryCity} &amp; Beyond</h2>
            <p class="text-lg text-muted-foreground leading-relaxed mb-4">
              We cover {business.primaryCity}, Edinburgh, Stirling and towns right across {business.region}.
            </p>
            <div class="flex flex-wrap gap-3">
              {townLocations.map((location) => (
                <a href={`/locations/${location.slug}`} class="px-4 py-2 rounded-full bg-muted/50 border border-border hover:border-primary/30 hover:text-primary transition-colors text-sm font-medium">
                  {location.name}
                </a>
              ))}
            </div>
          </div>

          <div>
            <h2 class="font-display font-bold text-3xl text-foreground mb-4">Our Services</h2>
            <div class="flex flex-wrap gap-3">
              {categories.map((category) => (
                <a href={`/${category.slug}`} class="px-4 py-2 rounded-full bg-primary/10 text-primary hover:bg-primary hover:text-white transition-colors text-sm font-medium">
                  {category.name}
                </a>
              ))}
            </div>
          </div>

          <div>
            <h2 class="font-display font-bold text-3xl text-foreground mb-4">Get in Touch</h2>
            <p class="text-lg text-muted-foreground leading-relaxed mb-4">
              Follow our latest projects on Facebook, or read what past customers have to say on our <a href="/reviews" class="text-primary hover:underline">reviews page</a>.
            </p>
            <a
              href={business.facebookUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-primary hover:underline font-semibold"
            >
              <Facebook client:load class="w-5 h-5" />
              Follow us on Facebook
            </a>
          </div>
        </div>
      </section>

      <section class="py-20 px-4 bg-primary text-white">
        <div class="container mx-auto max-w-4xl text-center">
          <h2 class="font-display text-3xl md:text-4xl font-bold mb-6">Ready to Get Started?</h2>
          <p class="text-xl text-white/90 mb-8">Get a free, no-obligation quote for your decking or fencing project.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary hover:bg-gray-100 font-bold text-lg rounded-xl transition-colors duration-200">
              Get a Free Quote
            </a>
            <a href={business.phoneTel} class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white hover:bg-white hover:text-primary font-semibold text-lg rounded-xl transition-colors duration-200">
              Call {business.phoneLocal}
            </a>
          </div>
        </div>
      </section>

      </main>

      <Footer client:load />
    </div>
  </Providers>

  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <BreadcrumbSchema items={[
    { name: 'Home', href: '/' },
    { name: 'About', href: '/about' },
  ]} />

  <script>
    import { trackPageView } from '@/utils/analytics';
    if (typeof window !== 'undefined') {
      trackPageView(window.location.pathname, document.title);
    }
  </script>
</Layout>
