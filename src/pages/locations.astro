---
import Layout from '@/layouts/Layout.astro';
import Navigation from '@/components/Navigation';
import Footer from '@/components/Footer';
import Providers from '@/components/Providers';
import { MapPin, ArrowRight } from 'lucide-react';
import { locations } from '@/data/locations';

const countyOrder = [
  "Glasgow City",
  "City of Edinburgh",
  "Stirling",
  "Renfrewshire",
  "East Renfrewshire",
  "South Lanarkshire",
  "North Lanarkshire",
  "West Dunbartonshire",
  "East Dunbartonshire",
  "Inverclyde",
  "West Lothian",
  "Falkirk",
  "Fife",
  "South Ayrshire",
  "East Ayrshire",
  "North Ayrshire",
];

const groupedLocations = countyOrder
  .map((county) => ({
    county,
    items: locations.filter((location) => location.county === county),
  }))
  .filter((group) => group.items.length > 0);
---

<Layout
  title="Areas We Cover | Glasgow, Edinburgh & Stirling | Clyde Decking Solutions"
  description="Clyde Decking Solutions provides decking and fencing services across Glasgow, Edinburgh and Stirling. Find your area and get a free quote."
  canonical="https://clydedeckingsolutionsltd.com/locations"
>
  <Providers client:load>
    <div class="min-h-screen bg-background">
      <Navigation client:load />

      {/* Hero Section */}
      <section class="relative py-24 px-4 pt-32 bg-gradient-to-br from-primary/10 via-primary/5 to-background">
        <div class="container mx-auto max-w-6xl">
          <div class="text-center mb-4">
            <h1 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl text-foreground mb-6">
              Areas We <span class="text-primary">Cover</span>
            </h1>
            <p class="text-xl text-muted-foreground max-w-3xl mx-auto leading-relaxed mb-8">
              Decking and fencing installers serving Glasgow, Edinburgh, Stirling and the surrounding towns of Scotland's Central Belt.
            </p>
            <a
              href="/contact"
              class="inline-flex items-center justify-center px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-bold text-lg rounded-xl transition-colors duration-200"
            >
              Get a Free Quote
            </a>
          </div>
        </div>
      </section>

      {/* Locations Grid, grouped by council area */}
      <section class="py-20 px-4">
        <div class="container mx-auto max-w-6xl space-y-14">
          {groupedLocations.map((group) => (
            <div>
              <h2 class="font-display font-bold text-2xl text-foreground mb-6 flex items-center gap-2">
                <MapPin class="w-5 h-5 text-primary" />
                {group.county}
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {group.items.map((location) => (
                  <a
                    href={`/${location.slug}`}
                    class="group flex items-center justify-between bg-white rounded-xl px-5 py-4 shadow-sm hover:shadow-md transition-shadow duration-300"
                  >
                    <span class="font-semibold text-foreground group-hover:text-primary transition-colors">
                      {location.name}
                    </span>
                    <ArrowRight class="w-4 h-4 text-primary opacity-0 group-hover:opacity-100 transition-opacity" />
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* CTA Section */}
      <section class="py-16 px-4 bg-primary text-white">
        <div class="container mx-auto max-w-4xl text-center">
          <h2 class="font-display font-bold text-4xl mb-4">
            Not sure if we cover your area?
          </h2>
          <p class="text-xl mb-8 opacity-90">
            Get in touch and we'll confirm coverage for your postcode.
          </p>
          <a
            href="/contact"
            data-track-source="locations_cta"
            class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary rounded-full font-semibold hover:bg-gray-100 transition-colors"
          >
            Get a Free Quote
          </a>
        </div>
      </section>

      <Footer client:load />
    </div>
  </Providers>
</Layout>

<script>
  import { trackPageView } from '@/utils/analytics';

  if (typeof window !== 'undefined') {
    trackPageView(window.location.pathname, document.title);
  }
</script>
